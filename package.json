{
  "name": "@dhis2/api-types",
  "version": "0.0.0",
  "description": "TypeScript types for the DHIS2 REST API, generated from the OpenAPI specification",
  "type": "module",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhis2/api-types.git"
  },
  "types": "./src/latest.d.ts",
  "exports": {
    ".": {
      "types": "./src/latest.d.ts"
    },
    "./v40": {
      "types": "./src/v40.d.ts"
    },
    "./v41": {
      "types": "./src/v41.d.ts"
    },
    "./v42": {
      "types": "./src/v42.d.ts"
    },
    "./v43": {
      "types": "./src/v43.d.ts"
    },
    "./utils": {
      "types": "./src/utils.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "v40": [
        "./src/v40.d.ts"
      ],
      "v41": [
        "./src/v41.d.ts"
      ],
      "v42": [
        "./src/v42.d.ts"
      ],
      "v43": [
        "./src/v43.d.ts"
      ],
      "utils": [
        "./src/utils.d.ts"
      ]
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "fetch-specs": "tsx scripts/fetch-specs.ts",
    "generate": "tsx scripts/generate.ts",
    "update": "npm run fetch-specs && npm run generate",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^25.9.1",
    "changeset-conventional-commits": "^0.2.5",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.6.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
